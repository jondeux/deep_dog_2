# Copy to .env. These are the only keys needed by scripts/quickstart.py.
# Choose models, agents, search and limits in that script's CONFIG block.
DEEPSEEK_API_KEY=
EXA_API_KEY=

# Only if you choose an OpenRouter model or enable OpenRouter routing:
# OPENROUTER_API_KEY=

# Only if you choose a hosted open model with an explicit prefix, e.g.
# "deepinfra:deepseek-ai/DeepSeek-V3", "together:openai/gpt-oss-120b" or
# "fireworks:accounts/fireworks/models/llama-v3p3-70b-instruct":
# DEEPINFRA_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=

# If web_search_engine="tavily" or "both":
# TAVILY_API_KEY=

# If ResearchReddit is enabled:
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# If ResearchSubstack is enabled (Perplexity-backed search):
# PERPLEXITY_API_KEY=

# Contact details for specialist agents:
# PUBMED_EMAIL=
# SEC_EDGAR_CONTACT_EMAIL=

# If RunConfig(langsmith_tracing=True): sends prompts, search results and
# reports to your LangSmith project (see README, "LangSmith tracing").
# LANGSMITH_API_KEY=
# EU workspace only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
