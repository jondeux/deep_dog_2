{
  "version": 1,
  "_doc": "Default hooks-architect policy. Override per project in .claude/hooks-policy.json (dicts merge, lists append, scalars replace; list rule ids under \"disable\"). Decisions: deny > ask > approval > allow. Schema: references/policy-schema.md",

  "paths": {
    "zero_access": [
      ".env", ".env.*", "*.env", ".envrc",
      "*.pem", "*.key", "*.p12", "*.pfx", "*.keystore", "*.jks",
      "id_rsa*", "id_dsa*", "id_ecdsa*", "id_ed25519*",
      "~/.ssh/**", "~/.aws/**", "~/.gnupg/**", "~/.config/gcloud/**", "~/.azure/**", "~/.kube/**",
      "~/.claude/.credentials.json", "~/.claude.json",
      "~/.docker/config.json", "~/.netrc", "~/.npmrc", "~/.pypirc", "~/.git-credentials", ".git-credentials",
      "credentials.json", "*-credentials.json", "*service-account*.json", "*serviceAccount*.json",
      "secrets.yaml", "secrets.yml", "*-secret.yaml", "*.tfstate", "*.tfstate.backup",
      "/proc/*/environ"
    ],
    "allow": [".env.example", ".env.sample", ".env.template", ".env.dist", "*.env.example"],
    "read_only": ["/etc/**", "/usr/**", "/bin/**", "/sbin/**", "/lib/**", "/lib64/**", "/boot/**", "/sys/**",
                  "~/.bashrc", "~/.zshrc", "~/.profile", "~/.bash_profile"],
    "no_delete": [".git", ".git/**", ".claude/hooks", ".claude/hooks/**", ".claude/settings.json", ".claude/hooks-policy.json"],
    "protected": [".claude/settings.json", ".claude/settings.local.json", ".claude/hooks/**", ".claude/hooks-policy.json"],
    "disposable": ["node_modules", "build", "dist", ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache",
                   ".ruff_cache", ".cache", "coverage", "htmlcov", ".coverage", ".next", ".nuxt", "target", "out",
                   ".tox", ".nox", ".turbo", ".parcel-cache", "*.egg-info", "*.pyc", "*.pyo", "*.log", "tmp", ".tmp"],
    "disposable_roots": ["/tmp/**", "/var/tmp/**", "$TMPDIR/**"]
  },

  "git": [
    {"id": "git-force-push", "sub": "push", "force": true, "decision": "deny",
     "reason": "Force push rewrites shared history. Use --force-with-lease, which still needs the user's approval."},
    {"id": "git-push-mirror", "sub": "push", "any": ["--mirror"], "decision": "deny",
     "reason": "git push --mirror can delete every remote ref."},
    {"id": "git-push-delete", "sub": "push", "any": ["--delete", "-d"], "colon_refspec": true, "decision": "ask",
     "reason": "This deletes a remote branch."},
    {"id": "git-push", "sub": "push", "decision": "approval", "approve": "push", "unless_any": ["--dry-run", "-n", "--help", "-h"],
     "reason": "Pushing needs the user's approval in their latest message (for example \"push\")."},
    {"id": "git-commit", "sub": "commit", "decision": "approval", "approve": "commit", "unless_any": ["--help", "-h", "--dry-run"],
     "reason": "Committing needs the user's approval in their latest message (for example \"commit\")."},
    {"id": "git-revert", "sub": "revert", "decision": "approval", "approve": "commit", "unless_any": ["--help", "-h"],
     "reason": "git revert creates a commit, which needs the user's approval."},
    {"id": "git-reset-hard", "sub": "reset", "any": ["--hard", "--merge", "--keep"], "decision": "ask",
     "reason": "This discards uncommitted work."},
    {"id": "git-clean", "sub": "clean", "any": ["--force"], "any_short": "f", "decision": "ask",
     "reason": "git clean -f deletes untracked files permanently."},
    {"id": "git-checkout-discard", "sub": "checkout", "any": ["-f", "--force", "."], "dashdash_paths": true, "decision": "ask",
     "reason": "This overwrites uncommitted changes in the working tree."},
    {"id": "git-restore", "sub": "restore", "unless_staged_only": true, "decision": "ask",
     "reason": "git restore discards working-tree changes."},
    {"id": "git-stash", "sub": "stash", "unless_first": ["list", "show"], "decision": "ask",
     "reason": "Stashing, popping, or dropping changes needs the user's approval."},
    {"id": "git-branch-force-delete", "sub": "branch", "any": ["-D"], "decision": "ask",
     "reason": "Force-deletes a branch even if it is unmerged."},
    {"id": "git-history-rewrite", "sub": ["filter-branch", "filter-repo"], "decision": "deny",
     "reason": "History rewrites are irreversible for collaborators; do them by hand."},
    {"id": "git-reflog-expire", "sub": "reflog", "first_any": ["expire", "delete"], "decision": "deny",
     "reason": "Expiring the reflog destroys the recovery path."},
    {"id": "git-gc-prune-now", "sub": "gc", "prefix_any": ["--prune=now", "--prune=all"], "decision": "deny",
     "reason": "Pruning now can lose unreachable commits for good."},
    {"id": "git-update-ref-delete", "sub": "update-ref", "any": ["-d"], "decision": "ask",
     "reason": "Deletes a ref directly."}
  ],

  "commands": [
    {"id": "iac-destroy", "cmd": ["terraform", "tofu", "terragrunt", "pulumi", "cdk", "serverless", "sls"],
     "args_regex": "^(destroy\\b|apply\\b.*\\s-destroy\\b|remove\\b)", "decision": "deny", "reason": "Infrastructure teardown."},
    {"id": "kubectl-delete-broad", "cmd": ["kubectl", "oc"], "args_regex": "\\bdelete\\b.*(\\b(namespace|ns)\\b|--all\\b)", "decision": "deny",
     "reason": "Deletes a namespace or every resource of a kind."},
    {"id": "kubectl-delete", "cmd": ["kubectl", "oc"], "args_regex": "\\bdelete\\b", "decision": "ask", "reason": "Deletes cluster resources."},
    {"id": "helm-uninstall", "cmd": ["helm"], "args_regex": "^(uninstall|delete)\\b", "decision": "ask", "reason": "Removes a release."},
    {"id": "gh-repo-delete", "cmd": ["gh"], "args_regex": "^repo\\s+delete\\b", "decision": "deny", "reason": "Deletes a GitHub repository."},
    {"id": "gh-destructive", "cmd": ["gh"], "args_regex": "^(release|secret|variable|pr|issue)\\s+(delete|close)\\b|^api\\b.*-X\\s*DELETE", "decision": "ask",
     "reason": "Changes or deletes GitHub state."},
    {"id": "aws-destroy", "cmd": ["aws"], "args_regex": "\\b(s3\\s+rm\\b.*--recursive|s3\\s+rb\\b|terminate-instances|delete-db-|delete-stack|delete-table|delete-cluster|delete-function|delete-bucket|iam\\s+delete-)",
     "decision": "deny", "reason": "Deletes cloud resources."},
    {"id": "gcloud-delete", "cmd": ["gcloud", "gsutil", "az", "doctl", "flyctl", "fly", "heroku", "vercel", "netlify", "wrangler", "firebase", "supabase"],
     "args_regex": "(\\bdelete\\b|\\bdestroy\\b|\\brm\\b.*-r|\\bprojects:delete\\b|apps:destroy|pg:reset|\\bdb\\s+reset\\b|\\bremove\\b)",
     "decision": "deny", "reason": "Deletes cloud resources."},
    {"id": "docker-prune", "cmd": ["docker", "podman"], "args_regex": "\\b(system\\s+prune|volume\\s+(rm|prune)|rmi\\s+.*-f)\\b", "decision": "ask",
     "reason": "Deletes containers, images, or volumes."},
    {"id": "sql-drop", "cmd": ["psql", "mysql", "mariadb", "sqlite3", "duckdb", "sqlcmd", "cockroach", "clickhouse-client"],
     "args_regex": "(?i)\\b(DROP\\s+(TABLE|DATABASE|SCHEMA)|TRUNCATE\\b|DELETE\\s+FROM\\s+[\\w.\\\"`]+\\s*(;|$|'|\\\"))", "decision": "deny",
     "reason": "Drops or empties a table. Add a WHERE clause or run it by hand."},
    {"id": "nosql-wipe", "cmd": ["redis-cli", "mongosh", "mongo"], "args_regex": "(?i)(FLUSHALL|FLUSHDB|dropDatabase)", "decision": "deny",
     "reason": "Wipes a database."},
    {"id": "dropdb", "cmd": ["dropdb", "mysqladmin"], "args_regex": "^(?!.*--help)", "decision": "deny", "reason": "Drops a database."},
    {"id": "chmod-777-recursive", "cmd": ["chmod"], "args_regex": "(-R|--recursive)\\b.*\\b0?777\\b|\\b0?777\\b.*(-R|--recursive)\\b", "decision": "deny",
     "reason": "Makes a tree world-writable."},
    {"id": "raw-disk", "cmd": ["dd"], "args_regex": "\\bof=/dev/(sd|hd|vd|xvd|nvme|disk|mmcblk)", "decision": "deny", "reason": "Writes to a raw disk."},
    {"id": "mkfs", "cmd_regex": "^mkfs(\\.|$)|^(fdisk|parted|wipefs|sgdisk)$", "decision": "deny", "reason": "Formats or repartitions a disk."},
    {"id": "power", "cmd": ["shutdown", "reboot", "halt", "poweroff"], "decision": "deny", "reason": "Stops the machine."},
    {"id": "kill-all", "cmd": ["kill"], "args_regex": "-(9|KILL)\\s+-1\\b", "decision": "deny", "reason": "Kills every process."},
    {"id": "npm-unpublish", "cmd": ["npm", "pnpm", "yarn"], "args_regex": "^unpublish\\b", "decision": "deny", "reason": "Unpublishes a package."},
    {"id": "publish", "cmd": ["npm", "pnpm", "yarn", "twine", "cargo", "gem", "poetry", "uv"], "args_regex": "^(publish|upload)\\b", "decision": "ask",
     "reason": "Publishing is outward-facing and hard to undo."}
  ],

  "env_dump": true,
  "secret_var_regex": "(KEY|TOKEN|SECRET|PASSW(OR)?D|CREDENTIAL|PRIVATE|AUTH|COOKIE|SESSION)",
  "pipe_to_shell": "ask",

  "approval": {"window_minutes": 30, "on_missing": "deny"},

  "context": {"git": true, "files": ["NOTES.md", "claude/project-state.md", ".claude/context/current.md"],
              "max_chars_per_file": 1500, "max_total_chars": 6000},

  "stop": {"command": "", "subdir": "", "timeout": 300, "max_blocks": 3, "guard_test_edits": true,
           "test_globs": ["tests/**", "test/**", "**/test_*.py", "**/*_test.py", "**/*.test.*", "**/*.spec.*"],
           "max_output_chars": 3000, "tickets": "", "check_id": "stop"},

  "audit": {"path": ".claude/logs/hooks-audit.jsonl", "max_field_chars": 300}
}
