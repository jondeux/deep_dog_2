{
  "checks": [
    {
      "id": "unit",
      "command": "python3 -m pytest -q -p no:cacheprovider --deselect tests/test_simple_research.py::test_simple_example",
      "fast": "bash scripts/stop_check.sh",
      "note": "2 known failures in tests/test_simple_research.py deselected (open issue: test expects scripts.simple_research.QUESTION, which no longer exists)"
    }
  ],
  "facets": {},
  "parallel": 2,
  "token_budget": 200000,
  "check_timeout": 900,
  "memory_py": ".claude/hooks/continuous-learning/memory.py",
  "forbidden": [],
  "eval_globs": [
    "skills/*/SKILL.md",
    "skills/*/references/**",
    "AGENTS.md",
    "CLAUDE.md",
    "**/INSTRUCTION.md",
    "INSTRUCTION.md"
  ],
  "test_globs": [
    "tests/**",
    "test/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
